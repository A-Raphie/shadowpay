# Copy to .env.local and fill in your values.

# Alchemy Starknet RPC key — used by mainnet + sepolia providers in
# src/utils/constants.ts. Get one free at https://alchemy.com.
# Paste ONLY the key here; the URL prefix is already in constants.ts.
# If omitted the app falls back to Lava public RPC.
NEXT_PUBLIC_PROVIDER_URL=your_alchemy_key_here

# Echo helper deployed on Sepolia — enables the Echo action there.
# Leave as 0x0 until you deploy one from the Echo tab, then paste the address.
NEXT_PUBLIC_STRK20_ECHO_HELPER_SEPOLIA=0x0
